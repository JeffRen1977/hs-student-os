# Copy to .env for local development. Placeholder values only — never commit real secrets.
# Production secrets come from Secret Manager, not from env files.

# local | test | staging | production
HSOS_APP_ENV=local
# Emulator-only projects must start with "demo-"; deployed envs reject them.
HSOS_GCP_PROJECT_ID=demo-hs-student-os
HSOS_API_PORT=8787
# anthropic | mock   (mock is rejected in staging/production)
HSOS_LLM_PROVIDER=mock
# cloud_tasks | local (local is rejected in staging/production)
HSOS_QUEUE_PROVIDER=local
# firestore | memory   (memory: in-process, lost on restart; rejected in staging/production)
HSOS_STORAGE_PROVIDER=firestore
# Run the outbox dispatcher + worker inside the API process (local queue only)
HSOS_LOCAL_WORKER_ENABLED=true
# Local worker HTTP auth only (>= 16 chars). Deployed workers use Google OIDC instead.
# HSOS_WORKER_SERVICE_TOKEN=replace-with-a-local-random-string
# Deployed only:
# HSOS_WORKER_OIDC_AUDIENCE=https://worker-xxxx.run.app
# HSOS_WORKER_SERVICE_ACCOUNT=tasks-invoker@PROJECT.iam.gserviceaccount.com
# HSOS_WORKER_URL=https://worker-xxxx.run.app
# HSOS_CLOUD_TASKS_LOCATION=us-central1
# HSOS_CLOUD_TASKS_QUEUE=runs
# JSON list of allowed browser origins for local web dev
HSOS_CORS_ALLOWED_ORIGINS=["http://localhost:8000"]

# Local development only. Staging/production refuse to start when these are set.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Set only via Secret Manager in deployed environments.
ANTHROPIC_API_KEY=replace-me
